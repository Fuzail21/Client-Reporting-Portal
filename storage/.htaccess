# Deny all access to this directory
# Files should only be served through the secure proxy (view_report.php)

<IfModule mod_authz_core.c>
    # Apache 2.4+
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order deny,allow
    Deny from all
</IfModule>

# Disable directory listing
Options -Indexes

# Disable script execution
<FilesMatch "\.(php|php5|phtml|cgi|pl|py|rb|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
